# This project does NOT use an Anthropic API key and makes no paid API request.
# Authentication is your existing Claude subscription, via the Claude Code CLI:
#
#     claude                 # log in once, in a browser
#     python hackathon.py auth
#
# On a machine with no browser, generate a long-lived subscription token with
# `claude setup-token` and set it here. Requires a Pro, Max, Team or Enterprise
# plan. Copy this file to .env and never commit the filled-in copy.
#
# Note: nothing in hackathon_os reads .env -- export the variable in your shell.
CLAUDE_CODE_OAUTH_TOKEN=
